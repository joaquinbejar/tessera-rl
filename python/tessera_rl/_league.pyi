from typing import Any

class League:
    def __init__(
        self,
        population: list[Any],
        roles: list[dict[str, Any]],
        *,
        elo_k: float = 16.0,
        trueskill: tuple[float, float, float] | None = None,
        rate_population: bool = False,
    ) -> None: ...
    @classmethod
    def load(cls, data: bytes) -> League: ...
    def save(self) -> bytes: ...
    def export(self) -> str: ...
    @property
    def round(self) -> int: ...
    def population(self) -> list[dict[str, Any]]: ...
    def ratings(self, role: int = 0) -> dict[str, Any]: ...
