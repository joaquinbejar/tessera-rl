from collections.abc import Sequence
from typing import Any, NoReturn

import numpy as np
from gymnasium import spaces
from pettingzoo import AECEnv, ParallelEnv

from tessera_rl._archive import Archive
from tessera_rl._env import Env as Env
from tessera_rl._env import native_kwargs as native_kwargs
from tessera_rl.masks import head_views as head_views

def relaxed_masks(
    row: np.ndarray, mask_heads: tuple[tuple[int, tuple[int, ...], int], ...]
) -> tuple[np.ndarray, ...]: ...
def agent_name(slot: int, generation: int) -> str: ...


class TesseraParallelEnv(ParallelEnv[str, Any, Any]):
    metadata: dict[str, Any]
    def __init__(
        self,
        env_id: str,
        seed: int | None = None,
        *,
        _pool: Any = None,
        render_mode: str | None = None,
        visible: str | None = None,
        agents: Any = ...,
        **kwargs: Any,
    ) -> None: ...
    def observation_space(self, agent: str) -> spaces.Space[Any]: ...
    def action_space(self, agent: str) -> spaces.Space[Any]: ...
    def state(self) -> Any: ...
    def set_reset_source(self, archive: Archive | None = None, weights: Sequence[int] | None = None) -> None: ...
    def reset_from(self, ids: Sequence[int], entries: Sequence[int]) -> Any: ...
    def reset(
        self, seed: int | None = None, options: dict[str, Any] | None = None
    ) -> tuple[dict[str, Any], dict[str, dict[str, Any]]]: ...
    def step(self, actions: dict[str, Any]) -> tuple[
        dict[str, Any],
        dict[str, float],
        dict[str, bool],
        dict[str, bool],
        dict[str, dict[str, Any]],
    ]: ...
    def render(self) -> np.ndarray | None: ...
    def close(self) -> None: ...

class TesseraAECEnv(AECEnv[str, Any, Any]):
    metadata: dict[str, Any]
    def __init__(
        self,
        env_id: str,
        seed: int | None = None,
        *,
        _pool: Any = None,
        render_mode: str | None = None,
        visible: str | None = None,
        agents: Any = ...,
        **kwargs: Any,
    ) -> None: ...
    def observation_space(self, agent: str) -> spaces.Space[Any]: ...
    def action_space(self, agent: str) -> spaces.Space[Any]: ...
    def state(self) -> Any: ...
    def observe(self, agent: str) -> Any: ...
    def set_reset_source(self, archive: Archive | None = None, weights: Sequence[int] | None = None) -> None: ...
    def reset_from(self, ids: Sequence[int], entries: Sequence[int]) -> Any: ...
    def reset(self, seed: int | None = None, options: dict[str, Any] | None = None) -> None: ...
    def step(self, action: Any) -> None: ...
    def render(self) -> np.ndarray | None: ...
    def close(self) -> None: ...

def parallel_env(env_id: str, seed: int | None = None, **kwargs: Any) -> TesseraParallelEnv: ...
def aec_env(env_id: str, seed: int | None = None, **kwargs: Any) -> AECEnv[str, Any, Any]: ...
def turn_masked_env(env_id: str, seed: int | None = None, **kwargs: Any) -> NoReturn: ...
