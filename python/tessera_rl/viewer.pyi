import os
from collections.abc import Callable
from contextlib import AbstractContextManager
from types import TracebackType
from typing import Any

from tessera_rl._env import Env

__all__ = ["LogitsLog", "Viewer", "logits_log", "serve", "show", "watch"]

class Viewer:
    def __init__(self, path: str | os.PathLike[str], env: Env, *, port: int = 0, logits: Any = "auto") -> None: ...
    @property
    def address(self) -> tuple[str, int]: ...
    @property
    def url(self) -> str: ...
    def close(self) -> None: ...
    def __enter__(self) -> Viewer: ...
    def __exit__(
        self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None
    ) -> None: ...

def serve(path: str | os.PathLike[str], env: Env, *, port: int = 0, open_browser: bool = False, logits: Any = "auto") -> Viewer: ...
def show(path: str | os.PathLike[str], env: Env, *, height: int = 600, logits: Any = "auto") -> Any: ...
def watch(env: Env, *, port: int = 0, logits: Callable[[int], Any] | None = None) -> Viewer: ...
class LogitsLog:
    replay_path: str
    shape: tuple[int, int, int]
    def __init__(self, replay_path: str | os.PathLike[str], env: Env) -> None: ...
    def step(self, logits: Any) -> None: ...
def logits_log(replay_path: str | os.PathLike[str], env: Env) -> AbstractContextManager[LogitsLog]: ...
