from typing import Any, Protocol

import numpy as np

from tessera_rl._env import Env, Step

class Stream(Protocol): ...

class Event(Protocol):
    def record(self, stream: Any) -> None: ...
    def synchronize(self) -> None: ...

class Backend(Protocol):
    def pinned(self, nbytes: int) -> tuple[int, Any]: ...
    def source(self, handle: Any, offset: int, nbytes: int) -> Any: ...
    def device_buffer(self, nbytes: int, dtype: np.dtype[Any], shape: tuple[int, ...]) -> tuple[Any, Any]: ...
    def stream(self) -> Any: ...
    def event(self) -> Any: ...
    def copy_async(self, dst: Any, src: Any, stream: Any) -> None: ...
    def stream_waits_current(self, stream: Any) -> None: ...
    def current_waits(self, event: Any) -> None: ...

class TorchBackend:
    device: Any
    def __init__(self, torch: Any, device: str) -> None: ...
    def pinned(self, nbytes: int) -> tuple[int, Any]: ...
    def source(self, handle: Any, offset: int, nbytes: int) -> Any: ...
    def device_buffer(self, nbytes: int, dtype: np.dtype[Any], shape: tuple[int, ...]) -> tuple[Any, Any]: ...
    def stream(self) -> Any: ...
    def event(self) -> Any: ...
    def copy_async(self, dst: Any, src: Any, stream: Any) -> None: ...
    def stream_waits_current(self, stream: Any) -> None: ...
    def current_waits(self, event: Any) -> None: ...

def torch_backend(device: str) -> TorchBackend: ...

class _Pending:
    events: dict[int | None, Any]
    def __init__(self) -> None: ...
    def wait(self, key: int | None = None, every: bool = True) -> None: ...

class _Owner:
    def __init__(self, handle: Any, pending: _Pending) -> None: ...
    def wait(self) -> None: ...

class PinnedAllocator:
    pending: _Pending
    def __init__(self, backend: Backend) -> None: ...
    def allocate(self, length: int, align: int) -> tuple[int, _Owner]: ...
    def source(self, address: int, nbytes: int) -> Any: ...

class _Session:
    def __init__(self, backend: Backend, allocator: PinnedAllocator) -> None: ...
    def before(self, name: str, args: tuple[Any, ...]) -> None: ...
    def to_device(self, step: Step, half: int | None = None) -> Step: ...
    def close(self) -> None: ...

class _Gated:
    def __init__(self, inner: Any, session: _Session) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

class DeviceEnv(Env):
    def host_outputs(self) -> Any: ...
    def reset(self, seed: int | None = None, ids: Any = None) -> Any: ...
    def reset_from(self, ids: Any, entries: Any) -> Any: ...
    def step(self, actions: Any) -> Any: ...
    def recv(self) -> Any: ...
    def restore_all(self, snapshot: Any) -> Any: ...
    def restore_pool(self, snapshot: Any, archive: Any = None) -> Any: ...
    def close(self) -> None: ...

def make(
    maker: Any, native_kwargs: dict[str, Any], mode: str, indexed: bool, device: str, backend: Backend | None
) -> DeviceEnv: ...
