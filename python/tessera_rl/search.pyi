from collections.abc import Callable, Mapping, Sequence
from os import PathLike
from typing import Any, NamedTuple, TypeAlias

import numpy as np

from tessera_rl._env import make as make

#: ``evaluator(obs, legal, hashes) -> (priors, values)`` (see the module notes).
_Evaluator: TypeAlias = Callable[
    [np.ndarray | dict[str, np.ndarray], np.ndarray, np.ndarray],
    tuple[np.ndarray, np.ndarray],
]

class Search:
    actions: int
    def __init__(self, env_id: str = "tessera/Connect4-v1", **options: Any) -> None: ...
    def set_root(self, record: bytes) -> None: ...
    def run(self, evaluator: _Evaluator | OnnxEvaluator) -> None: ...
    def root_visits(self) -> np.ndarray: ...
    def select_action(self, temperature: float = 0.0) -> int: ...
    def improved_policy(self) -> np.ndarray | None: ...
    def considered(self) -> np.ndarray | None: ...
    @property
    def calls(self) -> int: ...
    def tree_hash(self) -> int: ...
    @property
    def is_privileged(self) -> bool: ...

class GroupFailure(NamedTuple):
    slot: int | None
    message: str
    user_raised: bool

class SearchGroup:
    trees: int
    actions: int
    memory_bytes: int
    def __init__(
        self,
        trees: int,
        env_id: str = "tessera/Connect4-v1",
        slot_options: list[dict[str, Any] | None] | None = None,
        **options: Any,
    ) -> None: ...
    def set_root(self, i: int, record: bytes) -> None: ...
    def set_active(self, i: int, flag: bool) -> None: ...
    def active(self, i: int) -> bool: ...
    def run(self, evaluator: _Evaluator) -> None: ...
    def last_failure(self) -> GroupFailure | None: ...
    def root_visits(self, i: int) -> np.ndarray: ...
    def select_action(self, i: int, temperature: float = 0.0) -> int: ...
    def improved_policy(self, i: int) -> np.ndarray | None: ...
    def considered(self, i: int) -> np.ndarray | None: ...
    def calls(self, i: int) -> int: ...
    def tree_hash(self, i: int) -> int: ...

ONNXRUNTIME_VERSION: str

class OnnxEvaluator:
    def __init__(
        self,
        model: str | PathLike[str],
        *,
        library: str | PathLike[str] | None = None,
        accept_telemetry: bool = False,
        max_model_bytes: int | None = None,
    ) -> None: ...
    @property
    def provenance(self) -> Mapping[str, Any] | None: ...

def joint_log_prior(
    logits: Sequence[np.ndarray],
    nvec: Sequence[int],
    parents: Sequence[Sequence[int]] | None = None,
    active: Callable[[int, list[int]], bool] | None = None,
    legal: np.ndarray | None = None,
) -> np.ndarray: ...
