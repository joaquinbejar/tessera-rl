# Rust
/target/
**/*.rs.bk

# cargo-fuzz local outputs (also in fuzz/.gitignore; repeated here so they
# stay ignored when a branch without fuzz/ is checked out)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Python
__pycache__/
*.py[cod]
*.so
*.pyd
*.egg-info/
.venv/
venv/
dist/
build/
wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and OS
.idea/
.vscode/
.DS_Store
reference-training.json
